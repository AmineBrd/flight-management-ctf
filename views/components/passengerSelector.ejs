<div class="passenger-selector-wrapper">
    <div class="compact-selector">
        <div class="compact-icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M10 10C12.7614 10 15 7.76142 15 5C15 2.23858 12.7614 0 10 0C7.23858 0 5 2.23858 5 5C5 7.76142 7.23858 10 10 10Z" fill="currentColor"/>
                <path d="M10 12C5.58172 12 2 13.7909 2 16V20H18V16C18 13.7909 14.4183 12 10 12Z" fill="currentColor"/>
            </svg>
        </div>
        <div class="compact-content">
            <span class="compact-label">PASSENGERS</span>
            <div class="passenger-selector" data-field="<%= fieldName || 'passengers' %>">
                <button type="button" class="passenger-btn minus" aria-label="Decrease">−</button>
                <span class="passenger-count">01</span>
                <button type="button" class="passenger-btn plus" aria-label="Increase">+</button>
            </div>
        </div>
    </div>
</div>

