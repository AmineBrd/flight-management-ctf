<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>✈️ Flights</h1>
            <nav>
                <span>Welcome, <%= user.email %> (<%= user.role %>)</span>
                <% if (user.role === 'admin') { %>
                    <button onclick="showAddFlightForm()" class="btn btn-primary">Add Flight</button>
                <% } %>
                <a href="/auth/logout" class="btn btn-secondary">Logout</a>
            </nav>
        </header>
        
        <% if (user.role === 'admin') { %>
        <div id="addFlightForm" class="add-flight-form" style="display: none;">
            <h2>Add New Flight</h2>
            <form action="/flights" method="POST">
                <div class="form-group">
                    <label>Flight Number:</label>
                    <input type="text" name="flightNumber" required>
                </div>
                <div class="form-group">
                    <label>Origin:</label>
                    <input type="text" name="origin" required>
                </div>
                <div class="form-group">
                    <label>Destination:</label>
                    <input type="text" name="destination" required>
                </div>
                <div class="form-group">
                    <label>Departure Time:</label>
                    <input type="datetime-local" name="departureTime" required>
                </div>
                <div class="form-group">
                    <label>Arrival Time:</label>
                    <input type="datetime-local" name="arrivalTime" required>
                </div>
                <div class="form-group">
                    <label>Price:</label>
                    <input type="number" step="0.01" name="price" required>
                </div>
                <div class="form-group">
                    <label>Seats:</label>
                    <input type="number" name="seats" value="100">
                </div>
                <button type="submit" class="btn btn-primary">Create Flight</button>
                <button type="button" onclick="hideAddFlightForm()" class="btn btn-secondary">Cancel</button>
            </form>
        </div>
        <% } %>
        
        <main>
            <h2>Available Flights</h2>
            <% if (flights.length === 0) { %>
                <p>No flights available.</p>
            <% } else { %>
                <div class="flights-grid">
                    <% flights.forEach(flight => { %>
                        <div class="flight-card">
                            <h3><%= flight.flightNumber %></h3>
                            <p><strong>Route:</strong> <%= flight.origin %> → <%= flight.destination %></p>
                            <p><strong>Departure:</strong> <%= new Date(flight.departureTime).toLocaleString() %></p>
                            <p><strong>Arrival:</strong> <%= new Date(flight.arrivalTime).toLocaleString() %></p>
                            <p><strong>Price:</strong> $<%= flight.price %></p>
                            <p><strong>Available Seats:</strong> <%= flight.availableSeats %>/<%= flight.seats %></p>
                            <a href="/flights/<%= flight.id %>" class="btn btn-primary">View Details</a>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </main>
    </div>
    
    <script>
        function showAddFlightForm() {
            document.getElementById('addFlightForm').style.display = 'block';
        }
        
        function hideAddFlightForm() {
            document.getElementById('addFlightForm').style.display = 'none';
        }
    </script>
</body>
</html>

