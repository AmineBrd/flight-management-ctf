<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="main-header">
        <div class="header-container">
            <div class="logo-section">
                <div class="logo-icon">✈</div>
                <h1 class="logo-text">Flight Management System</h1>
            </div>
            <nav class="main-nav">
                <a href="/auth/login" class="nav-link">Login</a>
                <a href="/auth/register" class="nav-link nav-link-primary">Register</a>
            </nav>
        </div>
    </header>
    
    <main class="hero-section">
        <div class="hero-background">
            <div class="hero-overlay"></div>
            <div class="airplane-decoration">✈</div>
        </div>
        <div class="hero-content">
            <div class="hero-badge">Welcome</div>
            <h2 class="hero-title">Experience Excellence in Flight Management</h2>
            <p class="hero-description">
                Your trusted partner for seamless flight operations, bookings, and comprehensive travel management. 
                Built with security and reliability at its core.
            </p>
            <div class="hero-features">
                <div class="feature-item">
                    <div class="feature-icon">🔒</div>
                    <span>Secure Platform</span>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">⚡</div>
                    <span>Fast & Reliable</span>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">🌍</div>
                    <span>Global Reach</span>
                </div>
            </div>
            <div class="hero-actions">
                <a href="/auth/login" class="btn btn-primary-hero">Get Started</a>
                <a href="/auth/register" class="btn btn-secondary-hero">Create Account</a>
            </div>
        </div>
    </main>
    
    <footer class="main-footer">
        <p>&copy; 2024 Flight Management System. All rights reserved.</p>
    </footer>
</body>
</html>

