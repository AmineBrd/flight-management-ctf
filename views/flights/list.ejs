<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="flights-page">
    <div class="flights-background">
        <div class="flights-background-overlay"></div>
        <div class="flights-decoration-plane">✈</div>
    </div>
    
    <!-- Glassy Header -->
    <header class="flights-header-glass">
        <div class="flights-header-container">
            <div class="flights-logo-section">
                <div class="flights-logo-icon">✈</div>
                <div>
                    <h1 class="flights-header-title">Flight Management</h1>
                    <p class="flights-header-subtitle">Air Algérie</p>
                </div>
            </div>
            <nav class="flights-nav-glass">
                <div class="user-info-glass">
                    <span class="user-email-glass"><%= user.email %></span>
                    <span class="user-role-badge"><%= user.role %></span>
                </div>
                <% if (user.role === 'admin') { %>
                    <button onclick="showAddFlightForm()" class="btn-glass btn-glass-primary btn-small">
                        <span>+ Add Flight</span>
                    </button>
                <% } %>
                <a href="/auth/logout" class="btn-glass btn-glass-secondary btn-small">Logout</a>
            </nav>
        </div>
    </header>
    
    <div class="flights-wrapper">
        <div class="flights-content-container">
            <!-- Add Flight Form (Admin Only) -->
            <% if (user.role === 'admin') { %>
            <div id="addFlightForm" class="add-flight-form-glass" style="display: none;">
                <div class="form-header-glass">
                    <h2>Add New Flight</h2>
                    <button onclick="hideAddFlightForm()" class="close-btn-glass">×</button>
                </div>
                <form action="/flights" method="POST" class="flight-form-glass">
                    <div class="form-row-glass">
                        <div class="form-group-glass">
                            <label class="form-label-glass">Flight Number</label>
                            <input type="text" name="flightNumber" class="form-input-glass" placeholder="e.g., AA123" required>
                        </div>
                        <div class="form-group-glass">
                            <label class="form-label-glass">Price ($)</label>
                            <input type="number" step="0.01" name="price" class="form-input-glass" placeholder="0.00" required>
                        </div>
                    </div>
                    <div class="form-row-glass">
                        <div class="form-group-glass">
                            <label class="form-label-glass">Origin</label>
                            <input type="text" name="origin" class="form-input-glass" placeholder="Departure city" required>
                        </div>
                        <div class="form-group-glass">
                            <label class="form-label-glass">Destination</label>
                            <input type="text" name="destination" class="form-input-glass" placeholder="Arrival city" required>
                        </div>
                    </div>
                    <div class="form-row-glass">
                        <div class="form-group-glass">
                            <label class="form-label-glass">Departure Time</label>
                            <input type="datetime-local" name="departureTime" class="form-input-glass" required>
                        </div>
                        <div class="form-group-glass">
                            <label class="form-label-glass">Arrival Time</label>
                            <input type="datetime-local" name="arrivalTime" class="form-input-glass" required>
                        </div>
                    </div>
                    <div class="form-group-glass">
                        <label class="form-label-glass">Total Seats</label>
                        <input type="number" name="seats" class="form-input-glass" value="100" placeholder="100">
                    </div>
                    <div class="form-actions-glass">
                        <button type="submit" class="btn-glass btn-glass-primary">Create Flight</button>
                        <button type="button" onclick="hideAddFlightForm()" class="btn-glass btn-glass-secondary">Cancel</button>
                    </div>
                </form>
            </div>
            <% } %>
            
            <!-- Flights Section -->
            <div class="flights-section-glass">
                <div class="flights-section-header">
                    <h2 class="flights-section-title">Available Flights</h2>
                    <p class="flights-section-subtitle"><%= flights.length %> flight<%= flights.length !== 1 ? 's' : '' %> available</p>
                </div>
                
                <% if (flights.length === 0) { %>
                    <div class="empty-state-glass">
                        <div class="empty-icon">✈</div>
                        <h3>No Flights Available</h3>
                        <p>There are no flights scheduled at this time.</p>
                        <% if (user.role === 'admin') { %>
                            <button onclick="showAddFlightForm()" class="btn-glass btn-glass-primary">Add Your First Flight</button>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="flights-grid-glass">
                        <% flights.forEach(flight => { %>
                            <div class="flight-card-glass">
                                <div class="flight-card-header">
                                    <div class="flight-number-badge"><%= flight.flightNumber %></div>
                                    <div class="flight-route">
                                        <span class="route-origin"><%= flight.origin %></span>
                                        <span class="route-arrow">→</span>
                                        <span class="route-destination"><%= flight.destination %></span>
                                    </div>
                                </div>
                                <div class="flight-card-body">
                                    <div class="flight-info-row">
                                        <div class="flight-info-item">
                                            <span class="info-label">Departure</span>
                                            <span class="info-value"><%= new Date(flight.departureTime).toLocaleString() %></span>
                                        </div>
                                        <div class="flight-info-item">
                                            <span class="info-label">Arrival</span>
                                            <span class="info-value"><%= new Date(flight.arrivalTime).toLocaleString() %></span>
                                        </div>
                                    </div>
                                    <div class="flight-info-row">
                                        <div class="flight-info-item">
                                            <span class="info-label">Price</span>
                                            <span class="info-value price-value">$<%= flight.price %></span>
                                        </div>
                                        <div class="flight-info-item">
                                            <span class="info-label">Seats</span>
                                            <span class="info-value"><%= flight.availableSeats %>/<%= flight.seats %></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flight-card-footer">
                                    <a href="/flights/<%= flight.id %>" class="btn-glass btn-glass-primary btn-card">
                                        View Details
                                        <svg class="btn-arrow" width="16" height="16" viewBox="0 0 20 20" fill="none">
                                            <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <script>
        function showAddFlightForm() {
            const form = document.getElementById('addFlightForm');
            form.style.display = 'block';
            setTimeout(() => form.style.opacity = '1', 10);
        }
        
        function hideAddFlightForm() {
            const form = document.getElementById('addFlightForm');
            form.style.opacity = '0';
            setTimeout(() => form.style.display = 'none', 300);
        }
    </script>
</body>
</html>

