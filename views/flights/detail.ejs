<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="flight-detail-page">
    <!-- Modern Header -->
    <header class="detail-header">
        <div class="detail-header-container">
            <div class="detail-logo-section">
                <div class="detail-logo-icon">✈</div>
                <div>
                    <h1 class="detail-header-title">Flight Details</h1>
                    <p class="detail-header-subtitle">Air Algérie</p>
                </div>
            </div>
            <nav class="detail-nav">
                <div class="detail-user-info">
                    <span class="detail-user-email"><%= user.email %></span>
                    <span class="detail-role-badge"><%= user.role.toUpperCase() %></span>
                </div>
                <a href="<%= backUrl || '/flights' %>" class="btn-detail btn-detail-outline">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" style="margin-right: 6px;">
                        <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Back
                </a>
                <a href="/auth/logout" class="btn-detail btn-detail-secondary">Logout</a>
            </nav>
        </div>
    </header>
    
    <div class="detail-wrapper">
        <div class="detail-container">
            <!-- Flight Header Card -->
            <div class="detail-hero-card">
                <div class="detail-hero-content">
                    <div class="detail-flight-number-badge"><%= flight.flightNumber %></div>
                    <div class="detail-route-container">
                        <div class="detail-route-city">
                            <span class="detail-city-name"><%= flight.origin %></span>
                            <span class="detail-city-code"><%= flight.origin.substring(0, 3).toUpperCase() %></span>
                        </div>
                        <div class="detail-route-connector">
                            <svg width="80" height="24" viewBox="0 0 80 24" fill="none">
                                <path d="M5 12H75" stroke="#C8102E" stroke-width="2" stroke-linecap="round"/>
                                <path d="M70 7L75 12L70 17" stroke="#C8102E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="detail-route-city">
                            <span class="detail-city-name"><%= flight.destination %></span>
                            <span class="detail-city-code"><%= flight.destination.substring(0, 3).toUpperCase() %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Key Information Cards -->
            <div class="detail-cards-grid">
                <div class="detail-info-card departure-card">
                    <div class="detail-card-icon-wrapper departure-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M21 16V8C21 6.89543 20.1046 6 19 6H5C3.89543 6 3 6.89543 3 8V16C3 17.1046 3.89543 18 5 18H19C20.1046 18 21 17.1046 21 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M3 10H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M7 14H7.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="detail-card-content">
                        <span class="detail-card-label">Departure</span>
                        <span class="detail-card-value"><%= new Date(flight.departureTime).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
                        <span class="detail-card-time"><%= new Date(flight.departureTime).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %></span>
                    </div>
                </div>

                <div class="detail-info-card arrival-card">
                    <div class="detail-card-icon-wrapper arrival-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M21 16V8C21 6.89543 20.1046 6 19 6H5C3.89543 6 3 6.89543 3 8V16C3 17.1046 3.89543 18 5 18H19C20.1046 18 21 17.1046 21 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M3 10H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <path d="M17 14H17.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="detail-card-content">
                        <span class="detail-card-label">Arrival</span>
                        <span class="detail-card-value"><%= new Date(flight.arrivalTime).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
                        <span class="detail-card-time"><%= new Date(flight.arrivalTime).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %></span>
                    </div>
                </div>

                <div class="detail-info-card price-card">
                    <div class="detail-card-icon-wrapper price-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2V22M17 5H9.5C8.57174 5 7.6815 5.36875 7.02513 6.02513C6.36875 6.6815 6 7.57174 6 8.5C6 9.42826 6.36875 10.3185 7.02513 10.9749C7.6815 11.6313 8.57174 12 9.5 12H14.5C15.4283 12 16.3185 12.3687 16.9749 13.0251C17.6313 13.6815 18 14.5717 18 15.5C18 16.4283 17.6313 17.3185 16.9749 17.9749C16.3185 18.6313 15.4283 19 14.5 19H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="detail-card-content">
                        <span class="detail-card-label">Price</span>
                        <span class="detail-card-value price-value"><%= flight.price %> DZD</span>
                        <span class="detail-card-time">per person</span>
                    </div>
                </div>

                <div class="detail-info-card seats-card">
                    <div class="detail-card-icon-wrapper seats-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M9 5H7C5.89543 5 5 5.89543 5 7V19C5 20.1046 5.89543 21 7 21H9M9 5C9 3.89543 9.89543 3 11 3H13C14.1046 3 15 3.89543 15 5M9 5V21M15 5H17C18.1046 5 19 5.89543 19 7V19C19 20.1046 18.1046 21 17 21H15M15 5V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="detail-card-content">
                        <span class="detail-card-label">Available Seats</span>
                        <span class="detail-card-value"><%= flight.availableSeats %> / <%= flight.seats %></span>
                        <div class="detail-seats-progress">
                            <div class="detail-seats-bar" style="width: <%= (flight.availableSeats / flight.seats) * 100 %>%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Information Section -->
            <div class="detail-additional-info">
                <h3 class="detail-section-title">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" style="margin-right: 8px;">
                        <path d="M13 16H12V12H11M12 8H12.01M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Flight Information
                </h3>
                <div class="detail-info-grid">
                    <div class="detail-info-item">
                        <div class="detail-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61305 3.94821 5.32387 5.63604 3.63604C7.32387 1.94821 9.61305 1 12 1C14.3869 1 16.6761 1.94821 18.364 3.63604C20.0518 5.32387 21 7.61305 21 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="detail-info-content">
                            <span class="detail-info-label">Origin</span>
                            <span class="detail-info-value"><%= flight.origin %></span>
                        </div>
                    </div>
                    <div class="detail-info-item">
                        <div class="detail-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61305 3.94821 5.32387 5.63604 3.63604C7.32387 1.94821 9.61305 1 12 1C14.3869 1 16.6761 1.94821 18.364 3.63604C20.0518 5.32387 21 7.61305 21 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="detail-info-content">
                            <span class="detail-info-label">Destination</span>
                            <span class="detail-info-value"><%= flight.destination %></span>
                        </div>
                    </div>
                    <div class="detail-info-item">
                        <div class="detail-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M9 5H7C5.89543 5 5 5.89543 5 7V19C5 20.1046 5.89543 21 7 21H9M9 5C9 3.89543 9.89543 3 11 3H13C14.1046 3 15 3.89543 15 5M9 5V21M15 5H17C18.1046 5 19 5.89543 19 7V19C19 20.1046 18.1046 21 17 21H15M15 5V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="detail-info-content">
                            <span class="detail-info-label">Total Seats</span>
                            <span class="detail-info-value"><%= flight.seats %></span>
                        </div>
                    </div>
                    <div class="detail-info-item">
                        <div class="detail-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M8 2V6M16 2V6M3 10H21M5 4H19C20.1046 4 21 4.89543 21 6V20C21 21.1046 20.1046 22 19 22H5C3.89543 22 3 21.1046 3 20V6C3 4.89543 3.89543 4 5 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="detail-info-content">
                            <span class="detail-info-label">Created</span>
                            <span class="detail-info-value"><%= new Date(flight.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                        </div>
                    </div>
                    <% if (flight.updatedAt) { %>
                    <div class="detail-info-item">
                        <div class="detail-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <path d="M12 8V12L15 15M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="detail-info-content">
                            <span class="detail-info-label">Last Updated</span>
                            <span class="detail-info-value"><%= new Date(flight.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

