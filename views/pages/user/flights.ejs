<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="user-flights-page">
    <!-- Modern Header -->
    <header class="user-flights-header">
        <div class="user-flights-header-container">
            <div class="user-flights-logo-section">
                <div class="user-flights-logo-icon">✈</div>
                <div>
                    <h1 class="user-flights-header-title">Available Flights</h1>
                    <p class="user-flights-header-subtitle">Air Algérie</p>
                </div>
            </div>
            <nav class="user-flights-nav">
                <div class="user-flights-user-info">
                    <span class="user-flights-user-email"><%= user.email %></span>
                    <span class="user-flights-role-badge"><%= user.role.toUpperCase() %></span>
                </div>
                <a href="/" class="btn-user btn-user-outline">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="margin-right: 6px;">
                        <path d="M3 9L12 2L21 9V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V9Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 22V12H15V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Home
                </a>
                <a href="/auth/logout" class="btn-user btn-user-secondary">Logout</a>
            </nav>
        </div>
    </header>
    
    <div class="user-flights-wrapper">
        <div class="user-flights-container">
            <!-- Flights Section -->
            <div class="user-flights-content-card">
                <div class="user-flights-section-header">
                    <div>
                        <h2 class="user-flights-section-title">Available Flights</h2>
                        <p class="user-flights-section-subtitle"><%= flights.length %> flight<%= flights.length !== 1 ? 's' : '' %> available</p>
                    </div>
                </div>
                
                <% if (flights.length === 0) { %>
                    <div class="user-flights-empty-state">
                        <div class="user-flights-empty-icon">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none">
                                <path d="M21 16V8C21 6.89543 20.1046 6 19 6H5C3.89543 6 3 6.89543 3 8V16C3 17.1046 3.89543 18 5 18H19C20.1046 18 21 17.1046 21 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M3 10H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M7 14H7.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h3>No Flights Available</h3>
                        <p>There are no flights scheduled at this time. Please check back later.</p>
                    </div>
                <% } else { %>
                    <div class="user-flights-grid">
                        <% flights.forEach(flight => { %>
                            <div class="user-flight-card">
                                <div class="user-flight-card-header">
                                    <div class="user-flight-number"><%= flight.flightNumber %></div>
                                    <div class="user-flight-route">
                                        <div class="user-route-city">
                                            <span class="user-city-name"><%= flight.origin %></span>
                                            <span class="user-city-code"><%= flight.origin.substring(0, 3).toUpperCase() %></span>
                                        </div>
                                        <div class="user-route-connector">
                                            <svg width="60" height="20" viewBox="0 0 60 20" fill="none">
                                                <path d="M5 10H55" stroke="#C8102E" stroke-width="2" stroke-linecap="round"/>
                                                <path d="M50 5L55 10L50 15" stroke="#C8102E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </div>
                                        <div class="user-route-city">
                                            <span class="user-city-name"><%= flight.destination %></span>
                                            <span class="user-city-code"><%= flight.destination.substring(0, 3).toUpperCase() %></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="user-flight-card-body">
                                    <div class="user-flight-info-grid">
                                        <div class="user-flight-info-item">
                                            <div class="user-info-icon-wrapper departure">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                                    <path d="M21 16V8C21 6.89543 20.1046 6 19 6H5C3.89543 6 3 6.89543 3 8V16C3 17.1046 3.89543 18 5 18H19C20.1046 18 21 17.1046 21 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                    <path d="M3 10H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                                </svg>
                                            </div>
                                            <div class="user-info-content">
                                                <span class="user-info-label">Departure</span>
                                                <span class="user-info-value"><%= new Date(flight.departureTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                                                <span class="user-info-time"><%= new Date(flight.departureTime).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %></span>
                                            </div>
                                        </div>
                                        <div class="user-flight-info-item">
                                            <div class="user-info-icon-wrapper arrival">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                                    <path d="M21 16V8C21 6.89543 20.1046 6 19 6H5C3.89543 6 3 6.89543 3 8V16C3 17.1046 3.89543 18 5 18H19C20.1046 18 21 17.1046 21 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                    <path d="M3 10H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                                </svg>
                                            </div>
                                            <div class="user-info-content">
                                                <span class="user-info-label">Arrival</span>
                                                <span class="user-info-value"><%= new Date(flight.arrivalTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                                                <span class="user-info-time"><%= new Date(flight.arrivalTime).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %></span>
                                            </div>
                                        </div>
                                        <div class="user-flight-info-item">
                                            <div class="user-info-icon-wrapper price">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                                    <path d="M12 2V22M17 5H9.5C8.57174 5 7.6815 5.36875 7.02513 6.02513C6.36875 6.6815 6 7.57174 6 8.5C6 9.42826 6.36875 10.3185 7.02513 10.9749C7.6815 11.6313 8.57174 12 9.5 12H14.5C15.4283 12 16.3185 12.3687 16.9749 13.0251C17.6313 13.6815 18 14.5717 18 15.5C18 16.4283 17.6313 17.3185 16.9749 17.9749C16.3185 18.6313 15.4283 19 14.5 19H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </div>
                                            <div class="user-info-content">
                                                <span class="user-info-label">Price</span>
                                                <span class="user-info-value user-price-value"><%= flight.price %> DZD</span>
                                            </div>
                                        </div>
                                        <div class="user-flight-info-item">
                                            <div class="user-info-icon-wrapper seats">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                                    <path d="M9 5H7C5.89543 5 5 5.89543 5 7V19C5 20.1046 5.89543 21 7 21H9M9 5C9 3.89543 9.89543 3 11 3H13C14.1046 3 15 3.89543 15 5M9 5V21M15 5H17C18.1046 5 19 5.89543 19 7V19C19 20.1046 18.1046 21 17 21H15M15 5V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </div>
                                            <div class="user-info-content">
                                                <span class="user-info-label">Available</span>
                                                <span class="user-info-value"><%= flight.availableSeats %>/<%= flight.seats %></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="user-flight-card-footer">
                                    <a href="/flights/<%= flight.id %>" class="btn-user btn-user-primary btn-full">
                                        View Details
                                        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" style="margin-left: 8px;">
                                            <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>

