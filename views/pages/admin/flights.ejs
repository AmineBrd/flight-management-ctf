<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="admin-flights-page">
    <!-- Professional Header -->
    <header class="admin-header">
        <div class="admin-header-container">
            <div class="admin-logo-section">
                <div class="admin-logo-icon">✈</div>
                <div>
                    <h1 class="admin-header-title">Flight Management</h1>
                    <p class="admin-header-subtitle">Admin Panel - Air Algérie</p>
                </div>
            </div>
            <nav class="admin-nav">
                <div class="admin-user-info">
                    <span class="admin-user-email"><%= user.email %></span>
                    <span class="admin-role-badge">ADMIN</span>
                </div>
                <button onclick="showAddFlightForm()" class="btn-admin btn-admin-primary">
                    <span>+ Add Flight</span>
                </button>
                <a href="/admin/reports" class="btn-admin btn-admin-outline">Reports</a>
                <a href="/flights" class="btn-admin btn-admin-outline">User View</a>
                <a href="/auth/logout" class="btn-admin btn-admin-secondary">Logout</a>
            </nav>
        </div>
    </header>
    
    <div class="admin-wrapper">
        <div class="admin-container">
            <!-- Add Flight Form (Admin Only) -->
            <div id="addFlightForm" class="admin-form-card" style="display: none;">
                <div class="admin-form-header">
                    <h2>Add New Flight</h2>
                    <button onclick="hideAddFlightForm()" class="admin-close-btn">×</button>
                </div>
                <form action="/admin/flights" method="POST" class="admin-form">
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label class="admin-form-label">Flight Number</label>
                            <input type="text" name="flightNumber" class="admin-form-input" placeholder="e.g., AA123" required>
                        </div>
                        <div class="admin-form-group">
                            <label class="admin-form-label">Price (DZD)</label>
                            <input type="number" step="0.01" name="price" class="admin-form-input" placeholder="0.00" required>
                        </div>
                    </div>
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label class="admin-form-label">Origin</label>
                            <input type="text" name="origin" class="admin-form-input" placeholder="Departure city" required>
                        </div>
                        <div class="admin-form-group">
                            <label class="admin-form-label">Destination</label>
                            <input type="text" name="destination" class="admin-form-input" placeholder="Arrival city" required>
                        </div>
                    </div>
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label class="admin-form-label">Departure Time</label>
                            <input type="datetime-local" name="departureTime" class="admin-form-input" required>
                        </div>
                        <div class="admin-form-group">
                            <label class="admin-form-label">Arrival Time</label>
                            <input type="datetime-local" name="arrivalTime" class="admin-form-input" required>
                        </div>
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-form-label">Total Seats</label>
                        <input type="number" name="seats" class="admin-form-input" value="100" placeholder="100">
                    </div>
                    <div class="admin-form-actions">
                        <button type="submit" class="btn-admin btn-admin-primary">Create Flight</button>
                        <button type="button" onclick="hideAddFlightForm()" class="btn-admin btn-admin-secondary">Cancel</button>
                    </div>
                </form>
            </div>
            
            <!-- Flights Section -->
            <div class="admin-content-card">
                <div class="admin-section-header">
                    <div>
                        <h2 class="admin-section-title">Flight Management</h2>
                        <p class="admin-section-subtitle"><%= flights.length %> flight<%= flights.length !== 1 ? 's' : '' %> available</p>
                    </div>
                </div>
                
                <% if (flights.length === 0) { %>
                    <div class="admin-empty-state">
                        <div class="admin-empty-icon">✈</div>
                        <h3>No Flights Available</h3>
                        <p>There are no flights scheduled at this time.</p>
                        <button onclick="showAddFlightForm()" class="btn-admin btn-admin-primary">Add Your First Flight</button>
                    </div>
                <% } else { %>
                    <div class="admin-flights-grid">
                        <% flights.forEach(flight => { %>
                            <div class="admin-flight-card">
                                <div class="admin-card-header">
                                    <div class="admin-flight-number"><%= flight.flightNumber %></div>
                                    <div class="admin-flight-route">
                                        <span class="admin-route-origin"><%= flight.origin %></span>
                                        <span class="admin-route-arrow">→</span>
                                        <span class="admin-route-destination"><%= flight.destination %></span>
                                    </div>
                                </div>
                                <div class="admin-card-body">
                                    <div class="admin-info-row">
                                        <div class="admin-info-item">
                                            <span class="admin-info-label">Departure</span>
                                            <span class="admin-info-value"><%= new Date(flight.departureTime).toLocaleString() %></span>
                                        </div>
                                        <div class="admin-info-item">
                                            <span class="admin-info-label">Arrival</span>
                                            <span class="admin-info-value"><%= new Date(flight.arrivalTime).toLocaleString() %></span>
                                        </div>
                                    </div>
                                    <div class="admin-info-row">
                                        <div class="admin-info-item">
                                            <span class="admin-info-label">Price</span>
                                            <span class="admin-info-value admin-price"><%= flight.price %> DZD</span>
                                        </div>
                                        <div class="admin-info-item">
                                            <span class="admin-info-label">Seats</span>
                                            <span class="admin-info-value"><%= flight.availableSeats %>/<%= flight.seats %></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="admin-card-footer">
                                    <a href="/admin/flights/<%= flight.id %>" class="btn-admin btn-admin-primary btn-full">
                                        View Details
                                        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" style="margin-left: 8px;">
                                            <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </a>
                                    <div class="admin-card-actions">
                                        <button onclick="editFlight(<%= flight.id %>)" class="btn-admin btn-admin-outline btn-small">Edit</button>
                                        <form action="/admin/flights/<%= flight.id %>?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this flight?');">
                                            <button type="submit" class="btn-admin btn-admin-danger btn-small">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <script>
        function showAddFlightForm() {
            const form = document.getElementById('addFlightForm');
            form.style.display = 'block';
            form.style.opacity = '0';
            setTimeout(() => {
                form.style.opacity = '1';
            }, 10);
        }
        
        function hideAddFlightForm() {
            const form = document.getElementById('addFlightForm');
            form.style.opacity = '0';
            setTimeout(() => {
                form.style.display = 'none';
            }, 300);
        }
        
        function editFlight(flightId) {
            window.location.href = '/admin/flights/' + flightId + '/edit';
        }
    </script>
</body>
</html>

